<body link="#467886" vlink="#96607D">

<table border=0 cellpadding=0 cellspacing=0 width=300 style='border-collapse:
 collapse;width:225pt'>
<!--StartFragment-->
 <col width=100 span=3 style='width:75pt'>
 <tr height=24 style='height:18.0pt'>
  <td colspan=2 height=24 class=xl65 width=200 style='height:18.0pt;width:150pt'>상반기
  실적</td>
  <td rowspan=2 class=xl65 width=100 style='width:75pt'>비고</td>
 </tr>
 <tr height=24 style='height:18.0pt'>
  <td height=24 class=xl65 style='height:18.0pt'>1분기</td>
  <td class=xl65>2분기</td>
 </tr>
 <tr height=24 style='height:18.0pt'>
  <td height=24 align=right style='height:18.0pt'>100</td>
  <td align=right>200</td>
  <td>증가</td>
 </tr>
 <tr height=24 style='height:18.0pt'>
  <td height=24 align=right style='height:18.0pt'>150</td>
  <td align=right>120</td>
  <td>감소</td>
 </tr>
<!--EndFragment-->
</table>

