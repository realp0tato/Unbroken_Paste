<Project>

  <!-- 배포용 UP.exe (#27): .NET이 없는 Windows 10/11 x64 PC에서도 실행되는 파일 하나.
       저장소 루트에서: dotnet publish src/ClipBridge.Windows -p:PublishProfile=win-x64 → publish/windows/UP.exe -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WinForms·WPF(UI Automation)의 네이티브 DLL까지 한 파일에 넣는다. 처음 실행할 때 %TEMP%\.net에 풀린다 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 디버그 파일(.pdb)은 내보내지 않는다. 참조한 Core 프로젝트의 것도 함께 -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\windows\</PublishDir>
  </PropertyGroup>

</Project>
