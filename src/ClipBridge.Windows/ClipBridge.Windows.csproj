<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 트레이 앱. macOS에서도 빌드는 되지만 실행은 Windows에서만 가능 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ClipBridge.Windows</RootNamespace>
    <!-- 커서 아이콘(#5)이 포인터가 있는 모니터의 DPI를 따르도록 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 실행 파일 아이콘. 트레이 아이콘도 같은 파일을 쓴다 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="ClipBridge.Windows.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBridge.Core\ClipBridge.Core.csproj" />
  </ItemGroup>

</Project>
