<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 트레이 앱. macOS에서도 빌드는 되지만 실행은 Windows에서만 가능 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ClipBridge.Windows</RootNamespace>
    <!-- 프로그램 이름(실행 파일·작업 관리자·파일 속성)은 Unbroken Paste, 트레이·메뉴 등 그 밖의 화면은 UP
         (코드 이름은 추후 UnbrokenPaste.*로 변경, PRD 이름 규칙) -->
    <AssemblyName>Unbroken Paste</AssemblyName>
    <AssemblyTitle>Unbroken Paste</AssemblyTitle>
    <Product>Unbroken Paste</Product>
    <!-- 파일 속성의 버전 (macOS DMG와 같은 번호). 제품 버전에 커밋 해시를 붙이지 않는다 -->
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 커서 아이콘(#5)이 포인터가 있는 모니터의 DPI를 따르도록 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 실행 파일 아이콘. 트레이 아이콘도 같은 파일을 쓴다 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="ClipBridge.Windows.app.ico" />
    <!-- 복사 때 포인터 옆에 뜨는 UP 캐릭터 배지 (#5). macOS Resources/Characters/slime/badge.png와 같은 그림 -->
    <EmbeddedResource Include="Resources\badge.png" LogicalName="ClipBridge.Windows.badge.png" />
    <!-- 트레이 슬라임 애니메이션 프레임 (#44). 이름 순서대로 재생한다 -->
    <EmbeddedResource Include="Resources\Slime\*.png" LogicalName="ClipBridge.Windows.Slime.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 브라우저 주소창을 읽는 UI Automation(System.Windows.Automation)이 WPF 쪽 어셈블리에 있다 (#79) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBridge.Core\ClipBridge.Core.csproj" />
  </ItemGroup>

</Project>
