<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS 앱이 Core를 쓰기 위한 보조 프로그램. 표준 입출력으로 요청·응답 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClipBridge.Helper</RootNamespace>
  </PropertyGroup>

  <!-- dotnet publish -r osx-arm64 (또는 osx-x64) → .NET 설치 없이 실행되는 단일 파일 (README.md).
       RID를 줄 때만 적용한다 (테스트 프로젝트가 참조할 수 있도록) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClipBridge.Helper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBridge.Core\ClipBridge.Core.csproj" />
  </ItemGroup>

</Project>
